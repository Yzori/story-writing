# =============================================================================
# Inkwell — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Lines starting with # are comments and ignored.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/inkwell

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# GitHub OAuth (omit to disable GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email address for bootstrapping the first admin user
ADMIN_EMAIL=

# Override NextAuth callback URL (usually auto-detected from request headers)
NEXTAUTH_URL=http://localhost:3000
