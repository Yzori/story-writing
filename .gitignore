# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent / tooling config — machine-specific, not project state
.agents/
.codex/
.claude/worktrees/

# large media — host on CDN, not in git (exceeds GitHub 100MB limit)
/public/hero-video.mp4


# rendered promo video (regenerate via scripts/record-promo.mjs)
/promo-export/
/public/quiloria-promo.mp4
/public/quiloria-music.mp3

# Scratch / throwaway (screenshots, verify scripts, IDE)
scripts/.tmp-*.mjs
/*.png
.idea/

# local-disk media storage (see src/server/media.ts)
/uploads
